# Build-time configuration of the Cone Desktop (Slice 29 decision 5,
# cone-buzz-infra slices/29-branded-desktop.md). Read by desktop/src-tauri/build.rs
# at compile time; no secret ever goes in this file.
BUZZ_RELAY_URL=wss://buzz.cone.digital
BUZZ_RELAY_HTTP=https://buzz.cone.digital
# Presence-only markers: set means on.
BUZZ_BUILD_AUTO_CONNECT_DEFAULT_RELAY=1
# The owner-only marker (O96, ADR-0059 point 5): agents a person creates in this
# app answer their owner (and that owner's other agents) only.
BUZZ_BUILD_AGENT_ACCESS_OWNER_ONLY=1
# The update feed (decision 12), compiled into every build with the public key
# that cone/build-env.sh reads from cone/updater.pub (minisign key
# A11AAB7556EB3BE2, O102); with both set build.rs builds the updater in. A
# release reaches installed apps only when promoted (cone-desktop.yml).
BUZZ_UPDATER_ENDPOINT=https://buzz.cone.digital/desktop/latest.json
